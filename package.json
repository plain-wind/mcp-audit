    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test 'test/**/*.test.js'"
  },
  "keywords": [
    "mcp",
    "security",
    "audit",
    "npm",
    "vulnerability"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "ejs": "^3.1.10",
    "zod": "^3.25.76"
