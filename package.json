{
  "name": "mcp-audit",
  "version": "1.0.0",
  "description": "MCP 服务：审计前端工程的直接与间接依赖漏洞，返回 markdown 报告",
  "main": "src/entry/index.js",
  "type": "module",
  "bin": {
    "mcp-audit": "src/mcpServer.js"
  },
  "files": [
    "src",
    "README.md"
  ],
